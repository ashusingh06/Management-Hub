rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /courses/{courseCode} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'aashishsinghh06@gmail.com';
    }
    match /settings/{document} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'aashishsinghh06@gmail.com';
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}